# ==============================================================================
# Unified Cloud Platform - Production Environment Configuration Template
# Copy this file to .env.production before running in staging or production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NETWORK & DOMAIN ARCHITECTURE
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Canonical Production Subdomains (Configurable for staging / testing)
PUBLIC_DOMAIN=example.com
WWW_DOMAIN=www.example.com
ADMIN_DOMAIN=admin.example.com
PARTNER_DOMAIN=partners.example.com
API_DOMAIN=api.example.com

# ------------------------------------------------------------------------------
# 2. DATABASE PERSISTENCE (SQLite with WAL & Strict Foreign Keys)
# ------------------------------------------------------------------------------
# Path to the SQLite database file (absolute, or relative to the project root). Default: data/partner-system.db
# Keep it OUTSIDE assets/ - only the public pages and assets/ are served over HTTP.
PARTNER_DB_PATH=data/partner-system.db

# ------------------------------------------------------------------------------
# 3. APACHE CLOUDSTACK INTEGRATION (IaaS Orchestration)
# ------------------------------------------------------------------------------
# CloudStack Management Server REST API Endpoint
CLOUDSTACK_API_URL=http://cloudstack.dhaka.unifiedit.xyz:8080/client/api
CLOUDSTACK_API_KEY=your_production_cloudstack_api_key_here
CLOUDSTACK_SECRET_KEY=your_production_cloudstack_secret_key_here
CLOUDSTACK_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# 4. WHMCS BILLING & CLIENT MANAGEMENT
# ------------------------------------------------------------------------------
# WHMCS Enterprise API Endpoint & Server Secret
WHMCS_API_URL=https://billing.unifiedit.xyz/includes/api.php
WHMCS_API_IDENTIFIER=your_whmcs_api_identifier
WHMCS_API_SECRET=your_whmcs_api_secret_key
WHMCS_AUTO_PROVISION=false

# ------------------------------------------------------------------------------
# 5. SECURITY & SESSION MANAGEMENT
# ------------------------------------------------------------------------------
# Session Lifetime in milliseconds (Default: 86400000 = 24 hours)
SESSION_TTL_MS=86400000

# Brute-force threshold: Lock account for 15 minutes after 5 consecutive failed attempts
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Set to 1 only when the app is reachable exclusively through the nginx/Caddy proxy.
# Then X-Real-IP (set by the proxy) is used for rate limiting; otherwise X-Forwarded-For is ignored.
TRUST_PROXY=1

# Extra origins (comma separated) allowed to make credentialed cross-origin API calls.
# The five domains above are always allowed; leave empty unless another front end calls the API.
CORS_ALLOWED_ORIGINS=

# First Super Admin for a fresh production database (password: 12+ characters).
# The seeded demo accounts' public passwords are disabled automatically when NODE_ENV=production.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# The bootstrap account is only created once; set BOOTSTRAP_ADMIN_RESET=1 for one start to force its password back.
# BOOTSTRAP_ADMIN_RESET=1
# ALLOW_DEMO_CREDENTIALS=1   # disposable demo environments only - never on a real deployment

# Send the Content-Security-Policy as report-only while trialling changes (default: enforced)
# CSP_REPORT_ONLY=1

# CSRF Cookie Protection & Cross-Domain Isolation
# COOKIE_SECURE adds the Secure flag to the session cookie (default on when NODE_ENV=production).
# COOKIE_SAME_SITE: Strict | Lax | None (default Lax; None requires Secure).
# COOKIE_DOMAIN: share the session across subdomains (leave empty for a host-only cookie).
COOKIE_SECURE=true
COOKIE_SAME_SITE=Strict
COOKIE_DOMAIN=.example.com

# ------------------------------------------------------------------------------
# 6. PAYMENT GATEWAYS (Production Credentials)
# ------------------------------------------------------------------------------
# bKash Merchant API
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_MERCHANT_USERNAME=your_bkash_username
BKASH_MERCHANT_PASSWORD=your_bkash_password

# Nagad Corporate Disbursal & Collection
NAGAD_MERCHANT_ID=your_nagad_merchant_id
NAGAD_PUBLIC_KEY=your_nagad_public_key
NAGAD_PRIVATE_KEY=your_nagad_private_key

# SSLCommerz Multi-Currency Gateway
SSLCOMMERZ_STORE_ID=your_sslcommerz_store_id
SSLCOMMERZ_STORE_PASSWD=your_sslcommerz_store_password
SSLCOMMERZ_IS_SANDBOX=false
