# ==============================================================================
# Unified Cloud Platform & Partner Program Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=production

# WHMCS Billing & Client Management Integration
# Connects partner pricing to automated invoice generation and client orchestration
WHMCS_API_URL=https://billing.unifiedit.xyz/includes/api.php
WHMCS_API_IDENTIFIER=your_whmcs_api_identifier
WHMCS_API_SECRET=your_whmcs_api_secret_key

# Apache CloudStack Infrastructure Provisioning
# Server-side credentials for automated multi-tenant VM deployment and lifecycle
CLOUDSTACK_API_URL=http://cloudstack.dhaka.unifiedit.xyz:8080/client/api
CLOUDSTACK_API_KEY=your_cloudstack_api_key
CLOUDSTACK_SECRET_KEY=your_cloudstack_secret_key

# Database Configuration (Built-in SQLite)
# Defaults to data/partner-system.db
# PARTNER_DB_PATH=data/partner-system.db

# ------------------------------------------------------------------------------
# Agentic AI module (WHMCS stays the billing system; names only, set real values on the server)
# ------------------------------------------------------------------------------
# Shared secret used to sign WHMCS payment notifications (HMAC-SHA256). Required to activate services.
AGENTIC_WEBHOOK_SECRET=change_me_long_random_secret
# WHMCS product IDs created for the three configurations. Do not guess these; copy them from WHMCS.
AGENTIC_WHMCS_PID_READY_MADE=
AGENTIC_WHMCS_PID_CUSTOM_BRANDED=
AGENTIC_WHMCS_PID_CHAT_ONLY=
# Optional WHMCS addon IDs (maintenance and monthly backup) and the payment gateway module name.
AGENTIC_WHMCS_ADDON_MAINTENANCE=
AGENTIC_WHMCS_ADDON_BACKUP=
AGENTIC_WHMCS_PAYMENT_METHOD=
# Base URL of the WHMCS client area (defaults to the origin of WHMCS_API_URL).
WHMCS_CLIENT_AREA_URL=
# Label of the telephony provider that supplies call records. Leave empty if none is connected.
AGENTIC_TELEPHONY_PROVIDER=

# ------------------------------------------------------------------------------
# Agentic AI email notifications (SMTP). Nothing is hard-coded: set these on the server.
# Every message is stored in the admin "Email outbox" first, so a mail outage never loses a submission.
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (port 465); false = STARTTLS when the server offers it
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# From address, for example: Unified Cloud <noreply@your-domain>
MAIL_FROM=
# Business inbox that receives every Customized, Branded, Ready-Made and Chat-Only submission
AGENTIC_NOTIFY_EMAIL=
